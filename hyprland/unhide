ENTRY=$(hyprctl clients | awk -v hidden="0" '
    /^Window/ { current_id = $2 }
    # sub函数用于替换字符串的开头部分
    $0 ~ "title: " { sub(/.*title: /, "", $0); title = $0 }
    $0 ~ "hidden: " hidden { print title }
')

NODE_ID=$(hyprctl clients | awk -v hidden="0" '
    /^Window/ { current_id = $2 }
    # 提取title:后的内容直到末尾
    $0 ~ "hidden: " hidden { print current_id title }
  ')

if [ -z "$NODE_ID" ]; then
    notify-send "👻 Nothing is hidden." "Catch you later XD"
    exit
fi

ALL_ENTRY=()
index=0
len=${#ENTRY[@]}
echo "len: $len"
for ((idx=0; idx<len; idx++)); do
    ALL_ENTRY[index]="${ENTRY[idx]} ${NODE_ID[idx]}"
    index=$((index + 1))
done

echo $ALL_ENTRY

exit


chosen=$(printf '%s\n' "${ENTRY[@]}" | rofi -p "Unhide:" -dmenu -i | awk '{ print $1 }')

[ -n "$chosen" ] || exit

bspc node ${NODE_ID[$chosen]} -g hidden=off

